{
  "name": "Arham Electronics ERP",
  "short_name": "Arham ERP",
  "description": "Sales, purchases, stock and accounts for Arham Electronics.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F5FA",
  "theme_color": "#102C66",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New Sale", "url": "./?page=quicksale", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Payments to check", "url": "./?page=dashboard&open=pay", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Cash to confirm", "url": "./?page=cash&open=cash", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Daily Report", "url": "./?page=daily", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
